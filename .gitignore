# =====================================================================
# installer-assistant  –  .gitignore
# Put this file in the ROOT of the repository (next to README.md).
# The Unity project lives in unity/<ProjectName>/, so the Unity rules
# below are written for that location.
# =====================================================================

# ---- Unity: folders Unity rebuilds on every computer -----------------
unity/*/[Ll]ibrary/
unity/*/[Tt]emp/
unity/*/[Oo]bj/
unity/*/[Bb]uild/
unity/*/[Bb]uilds/
unity/*/[Ll]ogs/
unity/*/[Uu]ser[Ss]ettings/
unity/*/[Mm]emoryCaptures/
unity/*/[Rr]ecordings/

# Generated by IDEs / Unity for code editing
.vs/
.vscode/
.idea/
.gradle/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
*.pidb.meta
*.pdb.meta
*.mdb.meta
ExportedObj/
.consulo/

# Unity crash report file
sysinfo.txt

# Build outputs (share builds through a drive, not Git)
*.apk
*.aab
*.unitypackage

# Addressables / Android temporary assets
unity/*/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*
unity/*/[Aa]ssets/[Ss]treamingAssets/aa.meta
unity/*/[Aa]ssets/[Ss]treamingAssets/aa/*

# ---- Dataset: keep photos on the shared drive, not in Git ------------
/data/*
!/data/README.md

# ---- Secrets: never commit API keys ----------------------------------
secrets*.json
*.env
.env

# ---- Python (ml/) -----------------------------------------------------
__pycache__/
*.pyc
.venv/
venv/
ml/runs/
*.pt

# ---- Operating system files -------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
